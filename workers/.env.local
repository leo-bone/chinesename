# Local deployment secrets - NEVER commit this file to git!
# This file is already in .gitignore

# Get from Cloudflare dashboard (right sidebar)
CLOUDFLARE_ACCOUNT_ID=your_account_id_here

# Create one at: https://dash.cloudflare.com/profile/api-tokens
# Permissions needed: Cloudflare Workers:Edit
CLOUDFLARE_API_TOKEN=your_api_token_here

# ⚠️ 真实密钥不要写在这里 —— 用 `wrangler secret put DEEPSEEK_API_KEY` 写入（加密存储）。
#    本文件保留占位符会导致 wrangler deploy 把它当普通 var 注入，覆盖掉 secret。
# DEEPSEEK_API_KEY=your_deepseek_api_key_here
